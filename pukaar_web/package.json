{
  "name": "pukaar-web",
  "private": true,
  "version": "0.1.0",
  "description": "Pukaar rescuer dashboard for district control rooms (docs/dashboard-plan.md)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "start": "node scripts/preflight.mjs && node scripts/local-secrets.mjs && concurrently -k -n emu,web -c cyan,magenta \"npm:emulators\" \"wait-on -t 120000 tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 tcp:127.0.0.1:5001 && npm run seed && npm run dev:emulator\"",
    "emulators": "firebase emulators:start --config ../server/firebase.json --project demo-pukaar --only auth,firestore,functions",
    "seed": "node scripts/seed.mjs",
    "seed:150": "node scripts/seed.mjs --count 150",
    "seed:empty": "node scripts/seed.mjs --count 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource/mukta": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "firebase": "^12.19.0",
    "maplibre-gl": "^6.12.0",
    "material-symbols": "^0.47.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
