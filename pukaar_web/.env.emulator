# Used by `npm start` / `npm run dev:emulator`. Emulator-only values: the demo- project id
# keeps everything on this laptop and no real Firebase project is touched.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-pukaar
VITE_FIREBASE_APP_ID=demo-app
VITE_API_URL=http://127.0.0.1:5001/demo-pukaar/asia-south1/api
VITE_USE_EMULATORS=true
