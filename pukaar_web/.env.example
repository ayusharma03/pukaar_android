# Copy to .env.local for a real Firebase project (never commit .env.local).
# Web config from Firebase console > Project settings > Your apps. Not secret, but kept out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# The Cloud Function `api` (server/functions/index.js).
VITE_API_URL=https://asia-south1-your-project.cloudfunctions.net/api
# true only for the local Emulator Suite.
VITE_USE_EMULATORS=false
