    <!-- Onboarding (2m to 2g) -->
    <string name="pk_onb_more_languages">More languages coming</string>
    <string name="pk_onb_welcome_title">Call for help, even with no network</string>
    <string name="pk_onb_welcome_body">Pukaar passes your message from phone to phone until it reaches rescuers and your family.</string>
    <string name="pk_onb_how_title">How Pukaar works</string>
    <string name="pk_onb_how_1_title">Messages hop phone to phone</string>
    <string name="pk_onb_how_1_body">Over Bluetooth. No internet or SIM needed.</string>
    <string name="pk_onb_how_2_title">Any phone with internet passes them on</string>
    <string name="pk_onb_how_2_body">It happens on its own, in the background.</string>
    <string name="pk_onb_how_3_title">Rescuers see them on a map</string>
    <string name="pk_onb_how_3_body">And your family gets an SMS.</string>
    <string name="pk_onb_how_visible">Rescuers can read the Disaster Relief chat. Don\'t post anything private there.</string>
    <string name="pk_onb_perm_title">What Pukaar needs</string>
    <string name="pk_perm_nearby">Nearby phones</string>
    <string name="pk_perm_nearby_why">To pass messages without internet</string>
    <string name="pk_perm_nearby_impact">Not allowed. Pukaar can\'t reach nearby phones, so messages and SOS can only go by SMS.</string>
    <string name="pk_perm_location">Location</string>
    <string name="pk_perm_location_why">So rescuers know where you are</string>
    <string name="pk_perm_location_impact">Not allowed. Your SOS will go without your location.</string>
    <string name="pk_perm_notifications">Notifications</string>
    <string name="pk_perm_notifications_why">To tell you when help replies</string>
    <string name="pk_perm_notifications_impact">Not allowed. You won\'t see replies from rescuers or SOS from people nearby.</string>
    <string name="pk_perm_sms">SMS</string>
    <string name="pk_perm_sms_why">To text your family when there\'s signal</string>
    <string name="pk_perm_sms_impact">Not allowed. Your family will only hear from the server, once your SOS reaches it.</string>
    <string name="pk_perm_phone">Phone</string>
    <string name="pk_perm_phone_why">For one-tap emergency calls</string>
    <string name="pk_perm_phone_impact">Not allowed. Calls will open the dialler first, so it takes one more tap.</string>
    <string name="pk_onb_details_title">About you</string>
    <string name="pk_onb_details_body">Rescuers see this with your SOS.</string>
    <string name="pk_onb_contacts_title">Who should we tell?</string>
    <string name="pk_onb_contacts_body">They get an SMS with your location when you send an SOS. Up to 5 people.</string>
    <string name="pk_onb_offline_title">Save your area for offline use</string>
    <string name="pk_onb_offline_body">Download now while you have internet. It works later without any network.</string>
    <string name="pk_onb_offline_detected">Detected from your location</string>
    <string name="pk_onb_offline_download">Download about %1$d MB</string>
    <string name="pk_onb_offline_wifi">You\'re on Wi-Fi. This won\'t use mobile data.</string>
