    <!-- About -->
    <string name="pk_about_version">Version %1$s</string>
    <string name="pk_about_body">Pukaar helps people in a disaster send an SOS and talk to each other when there is no network. Messages pass phone to phone over Bluetooth until a phone with internet uploads them.</string>
    <string name="pk_about_credits">Credits and licences</string>
    <string name="pk_about_bitchat">Built on bitchat</string>
    <string name="pk_about_bitchat_licence">Bluetooth mesh by the bitchat project · GNU GPL v3</string>

