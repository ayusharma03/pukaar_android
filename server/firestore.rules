rules_version = '2';
// Only the Cloud Function (admin SDK) writes. SOS records hold phone numbers and medical notes,
// so reads are limited to signed-in dashboard staff with the role claim viewer, responder or admin
// (FR-28; admin ⊇ responder ⊇ viewer).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null && request.auth.token.role in ['viewer', 'responder', 'admin'];
      allow write: if false;
    }
  }
}
